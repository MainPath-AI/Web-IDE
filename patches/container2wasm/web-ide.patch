+# The network and editor must be running when their guest RAM is captured.
+# All preparation stays in the foreground; only the network relay is backgrounded.
+RUN set -eu; if test "${QEMU_MIGRATION}" = "true"; then \
+      printf 't:1\nn:02:00:00:00:00:01\n' > /tmp/wasi1/info; \
+      sed -i 's/connect=127.0.0.1:8888/listen=:8888/' /args-before-cp.json; \
+      ( i=0; while [ "$i" -lt 240 ]; do \
+          /c2w-net -p 18081:8080 127.0.0.1:8888 && exit 0; \
+          i=$((i+1)); sleep 1; \
+        done; exit 1 ) & \
+      network_pid=$!; \
+      trap 'kill "$network_pid" 2>/dev/null || true' EXIT; \
+      /get-qemu-state -output=/pack/vm.state --args-json=/args-before-cp.json \
