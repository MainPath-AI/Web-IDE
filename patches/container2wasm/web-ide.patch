+      if curl -fLsS --retry 3 --retry-all-errors --connect-timeout 15 --max-time 120 \
+          -o /tmp/zlib.tar.gz "$base/zlib-$ZLIB_VERSION.tar.gz" && \
+          echo 'bb329a0a2cd0274d05519d61c667c062e06990d72e125ee2dfa8de64f0119d16  /tmp/zlib.tar.gz' | sha256sum -c -; then \
+        tar zxf /tmp/zlib.tar.gz -C /zlib --strip-components=1; rm /tmp/zlib.tar.gz; exit 0; \
+      fi; \
+    done; exit 1
 WORKDIR /zlib
